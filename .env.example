############################################
# Application
############################################
# Core app identity, environment, and locale settings.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DOMAIN=localhost
APP_URL="http://${APP_DOMAIN}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Exposed to the frontend build.
VITE_APP_NAME="${APP_NAME}"

############################################
# Logging
############################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

############################################
# Database
############################################
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

############################################
# Session
############################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

############################################
# Cache
############################################
CACHE_STORE=database
# CACHE_PREFIX=

############################################
# Queue
############################################
QUEUE_CONNECTION=database

############################################
# Memcached & Redis
############################################
# Only relevant if CACHE_STORE, SESSION_DRIVER, or QUEUE_CONNECTION is set to use them.
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

############################################
# Horizon
############################################
# Dashboard for monitoring the Redis-backed queue (requires QUEUE_CONNECTION=redis).
HORIZON_NAME="Horizon"
HORIZON_DOMAIN="horizon.${APP_DOMAIN}"
HORIZON_PATH=
HORIZON_PREFIX=

############################################
# Filesystem & object storage
############################################
FILESYSTEM_DISK=local
MEDIA_DISK=s3

# S3-compatible storage for public files. Local development uses the RustFS service from docker-compose.yml.
AWS_ACCESS_KEY_ID=rustfsdev
AWS_SECRET_ACCESS_KEY=rustfsdevsecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_PUBLIC=regrowth
AWS_ENDPOINT_PUBLIC=http://rustfs:9000
AWS_URL_PUBLIC=http://localhost:9000/regrowth
AWS_BUCKET_PRIVATE=regrowth
AWS_ENDPOINT_PRIVATE=http://rustfs:9000
AWS_URL_PRIVATE=http://localhost:9000/regrowth
AWS_USE_PATH_STYLE_ENDPOINT=true
FORWARD_RUSTFS_PORT=9000
FORWARD_RUSTFS_CONSOLE_PORT=9001

# Production (DigitalOcean Spaces):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION={region}
# AWS_BUCKET_PUBLIC={public-space}
# AWS_ENDPOINT_PUBLIC=https://{region}.digitaloceanspaces.com
# AWS_URL_PUBLIC=https://{public-space}.{region}.cdn.digitaloceanspaces.com
# AWS_BUCKET_PRIVATE={private-space}
# AWS_ENDPOINT_PRIVATE=https://{region}.digitaloceanspaces.com
# AWS_URL_PRIVATE=https://{private-space}.{region}.digitaloceanspaces.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

############################################
# Broadcasting (Reverb WebSockets)
############################################
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Exposed to the frontend build; must mirror the REVERB_* values above.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

############################################
# Mail
############################################
# Not currently used by the application (no mail notifications are sent); left blank as unused scaffolding.
MAIL_MAILER=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

############################################
# Local development
############################################
# Run the API fetch commands at the end of a full db:seed. Keep false on production/staging.
SEED_FROM_APIS=false

# Discord snowflake IDs for the seeded test users used by the manual login
# flow and by view-as-role impersonation. Only consumed in local/testing.
LOCAL_USER_OFFICER_ID=
LOCAL_USER_LOOT_COUNCILLOR_ID=
LOCAL_USER_RAIDER_ID=
LOCAL_USER_MEMBER_ID=
LOCAL_USER_GUEST_ID=
LOCAL_USER_ADMIN_ID=

############################################
# Adobe Fonts
############################################
# Adobe Fonts (Typekit) kit stylesheet URL for the Semplicita web font.
TYPEKIT_URL=

############################################
# Blizzard API
############################################
# Battle.net API credentials for fetching game/character/item data.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_NAMESPACE=anniversary
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=en_GB
BLIZZARD_FILESYSTEM=s3

############################################
# Discord
############################################
# OAuth login, bot integration, and channel/role IDs for guild notifications.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
DISCORD_SERVER_ID=
DISCORD_INVITE_URL=
DISCORD_CHANNEL_ANNOUNCEMENTS=
DISCORD_CHANNEL_LOOTCOUNCIL=
DISCORD_CHANNEL_TBC_CHAT=
DISCORD_CHANNEL_OFFICER=

############################################
# Raid Helper
############################################
# Integration with the Raid Helper Discord bot for event signups.
RAID_HELPER_TOKEN=
RAID_HELPER_SERVER_ID=
RAID_HELPER_CHANNEL_IDS=
RAID_HELPER_WEBHOOK_KEY=

############################################
# Warcraft Logs
############################################
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
