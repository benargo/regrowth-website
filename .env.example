############################################
# Application
############################################
# Core app identity, environment, and locale settings.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DOMAIN=localhost
APP_URL="http://${APP_DOMAIN}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

############################################
# Logging
############################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

############################################
# Database
############################################
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

############################################
# Session
############################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

############################################
# Broadcasting, Cache & Queue
############################################
# Drivers for real-time broadcasting, caching, background jobs, and file storage.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

############################################
# Memcached & Redis
############################################
# Only relevant if CACHE_STORE, SESSION_DRIVER, or QUEUE_CONNECTION is set to use them.
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

############################################
# Horizon
############################################
# Dashboard for monitoring the Redis-backed queue (requires QUEUE_CONNECTION=redis).
HORIZON_NAME="Horizon"
HORIZON_DOMAIN="horizon.${APP_DOMAIN}"
HORIZON_PATH=
HORIZON_PREFIX=

############################################
# Mail
############################################
# Not currently used by the application (no mail notifications are sent); left blank as unused scaffolding.
MAIL_MAILER=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

############################################
# Reverb (WebSocket broadcasting)
############################################
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Exposed to the frontend build; must mirror the REVERB_* values above.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"

############################################
# Blizzard API
############################################
# Battle.net API credentials for fetching game/character/item data.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_GAME_VERSION=Anniversary
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=en_GB
BLIZZARD_FILESYSTEM=public

############################################
# Discord
############################################
# OAuth login, bot integration, and channel/role IDs for guild notifications.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
DISCORD_SERVER_ID=
DISCORD_CHANNEL_ANNOUNCEMENTS=
DISCORD_CHANNEL_DAILY_QUESTS=
DISCORD_CHANNEL_LOOTCOUNCIL=
DISCORD_CHANNEL_TBC_CHAT=
DISCORD_CHANNEL_OFFICER=
DISCORD_ROLE_DAILY_QUEST_SUBSCRIBERS=

############################################
# Manual Login (local/testing only)
############################################
# Discord snowflake IDs for the seeded test users used by the manual login
# flow and by view-as-role impersonation. Only consumed in local/testing.
LOCAL_USER_OFFICER_ID=
LOCAL_USER_LOOT_COUNCILLOR_ID=
LOCAL_USER_RAIDER_ID=
LOCAL_USER_MEMBER_ID=
LOCAL_USER_GUEST_ID=
LOCAL_USER_ADMIN_ID=

############################################
# Raid Helper
############################################
# Integration with the Raid Helper Discord bot for event signups.
RAID_HELPER_TOKEN=
RAID_HELPER_SERVER_ID=
RAID_HELPER_CHANNEL_IDS=
RAID_HELPER_WEBHOOK_KEY=

############################################
# Warcraft Logs
############################################
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
