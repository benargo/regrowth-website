{
    "mcpServers": {
        "laravel-boost": {
            "command": ".claude/hooks/boost-mcp.sh",
            "args": []
        },
        "laravel-inertia": {
            "type": "http",
            "url": "https://inertiajs.com/docs/mcp"
        },
        "saloon": {
            "type": "http",
            "url": "https://docs.saloon.dev/~gitbook/mcp"
        },
        "tailwindcss-server": {
            "command": "npx",
            "args": [
                "-y",
                "tailwindcss-mcp-server"
            ]
        }
    }
}
