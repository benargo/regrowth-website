{
    "mcpServers": {
        "laravel-boost": {
            "command": "vendor/bin/sail",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "saloon": {
            "url": "https://docs.saloon.dev/~gitbook/mcp"
        },
        "tailwindcss-server": {
            "command": "npx",
            "args": [
                "-y",
                "tailwindcss-mcp-server"
            ]
        }
    }
}