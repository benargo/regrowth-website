#
# MariaDB configuration for local development.
#
# Unlike the mysql/mysql-server image, MariaDB's image supports
# /etc/mysql/conf.d/, so this drop-in file only needs to state the logging
# settings below - no base defaults need restating here.
#
# The logging below exists to attribute destructive statements (DROP TABLE,
# TRUNCATE, mass DELETE) to the client that issued them, after a migrate:fresh
# wiped the development database on 2026-07-31.
#

[mariadb]

# --- Audit log ---
# Records connections (user, host, connection id) and every statement that
# changes schema, privileges or data (DROP, TRUNCATE, ALTER, INSERT, UPDATE,
# DELETE), but not SELECTs. This is the log that will name the culprit if the
# database is wiped again. It rotates itself at 100 MB, keeping 10 old files
# (~1.1 GB ceiling).
plugin_load_add             = server_audit
server_audit                = FORCE_PLUS_PERMANENT
server_audit_logging        = ON
server_audit_output_type    = file
server_audit_file_path      = /var/log/mysql/audit.log
server_audit_events         = CONNECT,QUERY_DDL,QUERY_DCL,QUERY_DML_NO_SELECT
server_audit_file_rotate_size = 104857600
server_audit_file_rotations = 10

# --- General query log ---
# Records every statement, including SELECTs, with no size limit. Off by
# default; enable temporarily with `SET GLOBAL general_log = 1` and disable
# again afterwards.
general_log      = 0
general_log_file = /var/log/mysql/general.log

# --- Error log ---
# Written to a bind-mounted file so it survives container recreation, unlike
# stderr captured by `docker logs`.
log_error = /var/log/mysql/error.log

# --- Connection attribution ---
# Logs connect/disconnect events with user and host to the error log.
# MariaDB equivalent of MySQL's log_error_verbosity.
log_warnings = 3

# --- Slow query log ---
# Records statements taking longer than one second, with the query plan and
# rows examined (via log_slow_verbosity). For a full profiling session, set
# `SET GLOBAL log_slow_query_time = 0` temporarily - at 0 every statement is
# logged and the file grows without limit.
# MariaDB equivalents: slow_query_log_file -> log_slow_query_file,
# long_query_time -> log_slow_query_time, log_slow_extra -> log_slow_verbosity.
slow_query_log      = 1
log_slow_query_file = /var/log/mysql/slow.log
log_slow_query_time = 1
log_slow_verbosity  = query_plan,explain

# --- Binary log ---
# The authoritative record of every data change, with timestamps and the
# server id that made them. `mysqlbinlog` can replay or inspect these, and they
# make point-in-time recovery possible - so a future wipe is survivable, not
# just diagnosable.
server-id                  = 1
log_bin                    = /var/log/mysql/binlog
binlog_format               = ROW
# Retain 14 days of binary logs (value is in seconds), capped at 3 GB in total.
binlog_expire_logs_seconds = 1209600
max_binlog_total_size      = 3G
max_binlog_size            = 256M
# Allow automatic purging with no replica connected. MariaDB 11.4+ defaults
# this to 1, which silently disables expiry on a standalone server.
slave_connections_needed_for_purge = 0
# Record the full "before" image of changed rows so deleted data can be
# reconstructed from the log.
binlog_row_image           = FULL
