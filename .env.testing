# =============================================================================
# Testing environment
# =============================================================================
# Laravel loads this file INSTEAD OF .env (not merged with it) when running
# PHPUnit or any Artisan command with --env=testing. Every key the app needs
# in the testing environment must therefore be present here.
#
# During `artisan test` the values in phpunit.xml <php><env> take precedence
# over anything set here (immutable dotenv). Keep the LOCAL_USER_*_ID values
# below in sync with phpunit.xml.

############################################
# Application
############################################
# Core app identity, environment, and locale settings.
APP_NAME=Regrowth
APP_ENV=testing
APP_KEY=base64:fgkHcY22oWJFxb9ZVTCMwtQtfAJtKpozr6RqYoNmVDA=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

# Exposed to the frontend build.
VITE_APP_NAME="${APP_NAME}"

############################################
# Logging
############################################
LOG_CHANNEL=testing
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

############################################
# Database
############################################
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=testing
DB_USERNAME=sail
DB_PASSWORD=password

############################################
# Session
############################################
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

############################################
# Cache
############################################
CACHE_STORE=array
CACHE_PREFIX=

############################################
# Queue
############################################
QUEUE_CONNECTION=sync

############################################
# Memcached & Redis
############################################
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

############################################
# Filesystem & object storage
############################################
FILESYSTEM_DISK=local
MEDIA_DISK=s3

# Dummy values so the s3 disk resolves without a network connection.
AWS_DEFAULT_REGION=ams3
AWS_BUCKET=testing
AWS_URL=https://cdn.test
AWS_ENDPOINT=http://127.0.0.1:9
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing

############################################
# Broadcasting (Reverb WebSockets)
############################################
BROADCAST_CONNECTION=log

# Dummy values, broadcasting is logged not sent in tests.
REVERB_APP_ID=test-app-id
REVERB_APP_KEY=test-app-key
REVERB_APP_SECRET=test-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Exposed to the frontend build; must mirror the REVERB_* values above.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

############################################
# Mail
############################################
MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

############################################
# Monitoring & search
############################################
# Not present in .env.example but required for the testing environment.
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
SCOUT_DRIVER=database

############################################
# Local development
############################################
# Never fetch from live APIs when seeding in tests
SEED_FROM_APIS=false

# Discord snowflake IDs for the seeded test users used by the manual login
# flow and by view-as-role impersonation. Only consumed in local/testing.
LOCAL_USER_OFFICER_ID=100000000000000001
LOCAL_USER_LOOT_COUNCILLOR_ID=100000000000000002
LOCAL_USER_RAIDER_ID=000000000000000000
LOCAL_USER_MEMBER_ID=000000000000000001
LOCAL_USER_GUEST_ID=000000000000000002
LOCAL_USER_ADMIN_ID=100000000000000003

############################################
# Adobe Fonts
############################################
# Dummy value, not used in tests.
TYPEKIT_URL=

############################################
# Blizzard API
############################################
# Dummy credentials so nothing hits a real API in tests.
BLIZZARD_CLIENT_ID=test_blizzard_client_id
BLIZZARD_CLIENT_SECRET=test_blizzard_client_secret
BLIZZARD_NAMESPACE=anniversary
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=en_GB
BLIZZARD_FILESYSTEM=s3

############################################
# Discord
############################################
DISCORD_CLIENT_ID=test_discord_client_id
DISCORD_CLIENT_SECRET=test_discord_client_secret
DISCORD_BOT_TOKEN=test_discord_bot_token
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
DISCORD_SERVER_ID=829020506907869214
DISCORD_CHANNEL_ANNOUNCEMENTS=000000000000000001
DISCORD_CHANNEL_LOOTCOUNCIL=000000000000000003
DISCORD_CHANNEL_TBC_CHAT=000000000000000004
DISCORD_CHANNEL_OFFICER=000000000000000005

############################################
# Raid Helper
############################################
RAID_HELPER_TOKEN=test_raid_helper_token
RAID_HELPER_SERVER_ID="${DISCORD_SERVER_ID}"
RAID_HELPER_CHANNEL_IDS=000000000000000001
RAID_HELPER_WEBHOOK_KEY=test_webhook_key

############################################
# Warcraft Logs
############################################
WCL_CLIENT_ID=test_client_id
WCL_CLIENT_SECRET=test_client_secret
